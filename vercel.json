{
  "version": 2,
  "crons": [
    { "path": "/api/cron/whatsapp", "schedule": "30 16 * * *" }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Axzen-POS.apk\"" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/cron/whatsapp", "dest": "/api/cron/whatsapp.js" },
    { "src": "/app/?", "dest": "/app/index.html" },
    { "src": "/downloads/(.*)", "dest": "/downloads/$1" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
