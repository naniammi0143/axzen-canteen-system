MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=axzen_canteen
JWT_SECRET=change_this_to_a_long_random_secret
VERIFY_TOKEN=change_this_to_your_meta_webhook_verify_token
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_API_VERSION=v25.0

# Cashfree Payment Gateway
# Set CASHFREE_ENV=production only after adding live Cashfree keys.
CASHFREE_CLIENT_ID=YOUR_CASHFREE_CLIENT_ID
CASHFREE_CLIENT_SECRET=YOUR_CASHFREE_CLIENT_SECRET
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01
CASHFREE_RETURN_URL=https://your-domain.com/mobile
PUBLIC_APP_URL=https://your-domain.com
CASHFREE_DEFAULT_EMAIL=support@your-domain.com

# RSA PKCS8 PEM encoded as base64. Keep the private key only on the backend.
APP_UPDATE_SIGNING_PRIVATE_KEY_BASE64=BASE64_ENCODED_PRIVATE_KEY

# Menu card reading uses Grok. Create a key at https://console.x.ai
CATALOG_AI_PROVIDER=grok
CATALOG_AI_MODEL=grok-4.7
XAI_API_KEY=your_xai_api_key
